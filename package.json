{
  "name": "ayqyn-local",
  "version": "0.2.3",
  "private": true,
  "description": "Local proctoring observations with human review",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "demo": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node scripts/audit-ui.mjs",
    "build:demo": "node scripts/build-demo.mjs",
    "package": "node scripts/package-windows.mjs",
    "setup:assets": "node scripts/download-runtime-models.mjs && node scripts/prepare-runtime.mjs",
    "lint": "eslint web desktop scripts tests eslint.config.mjs --max-warnings 0"
  },
  "devDependencies": {
    "@electron/packager": "18.4.4",
    "@playwright/test": "1.63.0",
    "electron": "44.5.1",
    "eslint": "10.12.0"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "onnxruntime-web": "1.30.0"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  }
}
